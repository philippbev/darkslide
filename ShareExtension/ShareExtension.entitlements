<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Same iCloud container as the main app. The extension writes recipes into the shared store,
	     and both processes must open it the *same* way: a second process writing a CloudKit-mirrored
	     store without mirroring of its own can produce rows the mirror never learns about. Without
	     this, the whole scan-and-save flow would have to refuse to run whenever sync is on. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>$(ICLOUD_CONTAINER_IDENTIFIER)</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Deliberately no ubiquity-kvstore-identifier. Neither target uses NSUbiquitousKeyValueStore
	     (see the note in FujiCookbook.entitlements); this extension reads the few settings it needs
	     from the App Group mirror. -->
	<!-- Shared Keychain so this extension can read the AI provider key the app stores. The same
	     build setting feeds the main app's entitlements and KeychainStore.accessGroup. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(APP_IDENTIFIER_BASE)</string>
	</array>
	<!-- Shared container for the recipe store, the settings suite, the on-disk AppLog and the
	     screenshot inbox: without it the extension can neither save a scan nor hand one off. The
	     same build setting feeds the main app's entitlements and AppIdentifiers.appGroup. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(APP_GROUP_IDENTIFIER)</string>
	</array>
</dict>
</plist>
