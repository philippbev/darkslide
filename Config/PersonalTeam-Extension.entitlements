<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Share Extension's entitlements, for a build on your own iPhone under a personal team (a free Apple ID). A personal
	     team can't sign iCloud or push, so those are left out: such a build has no iCloud sync.
	     Selected in Config/Local.xcconfig; see Local.example.xcconfig. -->
	<!-- Shared container for the library, logs and the screenshot inbox; see FujiCookbook.entitlements. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(APP_GROUP_IDENTIFIER)</string>
	</array>
	<!-- Shared Keychain for the AI provider key; see FujiCookbook.entitlements. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(APP_IDENTIFIER_BASE)</string>
	</array>
</dict>
</plist>
