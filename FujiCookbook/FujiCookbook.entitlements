<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>$(ICLOUD_CONTAINER_IDENTIFIER)</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- APNs delivers CloudKit's silent change notifications only to an app with this entitlement
	     (`UIBackgroundModes` in Info.plist is the other half). "development" here; Xcode's App Store
	     export sets "production" from the distribution profile. No notification is ever shown and the
	     app never asks for notification permission. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Deliberately no ubiquity-kvstore-identifier: nothing in the app uses the key-value store. -->
	<!-- The App Group container. It was shared with the Share Extension in earlier builds; the same
	     build setting feeds AppIdentifiers.appGroup. It names where the SwiftData store, the on-disk
	     AppLog, saved camera reports and the settings suite live, so it is not a cosmetic string:
	     changing it relocates all of them, and any install carrying the old one opens an empty
	     library. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(APP_GROUP_IDENTIFIER)</string>
	</array>
	<!-- The Keychain group the serial-hash secret lives in (and the AI provider keys did, which
	     RetiredAIData deletes). Shared with the Share Extension in earlier builds; it keeps its name
	     because stored items live in it. The same build setting feeds KeychainStore. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(APP_IDENTIFIER_BASE)</string>
	</array>
</dict>
</plist>
