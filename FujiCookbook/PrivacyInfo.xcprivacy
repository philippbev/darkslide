<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- These entries must stay in step with the App Store Connect App Privacy answers; Apple checks
	     the two against each other. -->
	<!-- Empty on purpose — the label is "Data Not Collected". Nothing leaves the device to us or to
	     a third party; iCloud sync goes to the user's own iCloud account. Any row added here changes
	     the App Store label, so App Store Connect has to change in the same release. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- CA92.1: `UserDefaults.standard` and the App Group suite (`SharedDefaults.suite`), which
		     only the app itself reads and writes. The App Group has no other member since the Share
		     Extension was removed, so 1C8F.1 is no longer declared. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!-- `ImageCaptureTransport` times each PTP round trip with
		     `DispatchTime.now().uptimeNanoseconds` for the trace's `durationMs`: 35F9.1, time elapsed
		     between events within the app. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
